# Environment Variables
# Copy this file to .env and fill in the values

# Backend URL (Railway deployment)
BACKEND_URL=https://hammel-backend-production.up.railway.app

# Database (SQLite - no external DB needed)
DATABASE_URL=file:./dev.db

# NextAuth (only needed if you implement auth later)
NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3000
