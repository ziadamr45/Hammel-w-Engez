# Environment Variables / متغيرات البيئة

# Database / قاعدة البيانات (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Backend API Server / سيرفر الـ API الخارجي
# Local development:
BACKEND_URL="http://localhost:3031"
# Railway deployment:
# BACKEND_URL="https://hammel-backend-production.up.railway.app"
# Render deployment:
# BACKEND_URL="https://hammel-backend.onrender.com"

# NextAuth / المصادقة (optional)
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# App Settings / إعدادات التطبيق
NEXT_PUBLIC_APP_URL="http://localhost:3000"
